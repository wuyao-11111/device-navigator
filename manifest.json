{
  "manifest_version": 3,
  "name": "设备导航",
  "version": "1.0.6",
  "description": "从当前页面复制设备 ID，并用剪贴板设备 ID 快速打开相关页面。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "clipboardRead", "clipboardWrite"],
  "action": {
    "default_title": "设备导航",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "host_permissions": ["https://oms.emaldo.com/*", "https://api.github.com/*"]
}
