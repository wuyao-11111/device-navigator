{
  "manifest_version": 3,
  "name": "设备导航",
  "version": "1.0.3",
  "description": "从剪贴板快速打开设备页面并复制设备 ID。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["clipboardRead", "clipboardWrite", "tabs"],
  "action": {
    "default_title": "设备导航",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "host_permissions": ["https://oms.emaldo.com/*", "https://api.github.com/*"]
}
